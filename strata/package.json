{
  "name": "strata",
  "productName": "Strata",
  "version": "0.1.0",
  "description": "Strata — a desktop workspace for AI-powered development built around Claude Code CLI",
  "main": "./out/main/index.js",
  "author": "Strata",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --test tests/unit/logic.test.mjs",
    "test:e2e": "node tests/e2e/run.cjs",
    "postinstall": "node scripts/postinstall.mjs",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.2.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.500.0",
    "marked": "^15.0.0",
    "monaco-editor": "^0.52.2",
    "playwright-core": "^1.63.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.0"
  }
}
